# Painel Administrativo RutaUdea - Variáveis de Ambiente
# Copiar este arquivo para .env.local e preencher com os valores do Firebase Console
# Mais informações: https://firebase.google.com/docs/admin/setup

# === Firebase Admin SDK ===
# Obter em: Firebase Console → Project Settings → Service accounts → Generate new private key
#
# Essas variáveis são obrigatórias para que o painel admin se conecte ao projeto Firebase.

FIREBASE_PROJECT_ID=seu-project-id-aqui
FIREBASE_CLIENT_EMAIL=seu-service-account@seu-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\ncoloque-a-chave-privada-aqui\n-----END PRIVATE KEY-----\n"

# === Firebase Client (opcional) ===
# Necessário apenas se usar funcionalidades frontend diretamente.
# Para o painel admin, o uso do Admin SDK em API Routes é suficiente.
#
# Obter em: Firebase Console → Project Settings → General → SDK setup and configuration

NEXT_PUBLIC_FIREBASE_API_KEY=seu-api-key-aqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=seu-numero-mensageria
NEXT_PUBLIC_FIREBASE_APP_ID=seu-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=seu-id-medicao

# === Observações Importantes ===
#
# 1. O arquivo .env.local é ignorado pelo git (ver .gitignore) - nunca commitar credenciais!
# 2. As variables NEXT_PUBLIC_ podem ser acessadas pelo navegador.
# 3. As variables sem prefixo NEXT_PUBLIC só estão disponíveis no servidor (API Routes).
# 4. Após alterar las variables, reiniciar o servidor: npm run dev
# 5. Las keys del servicio account deben tener permisos de leitura/escritura en Firestore y Auth.